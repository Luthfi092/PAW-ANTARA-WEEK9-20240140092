<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard - Todo App</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">📝 Todo App</span>
      <button id="logoutBtn" class="btn btn-outline-light btn-sm">Logout</button>
    </div>
  </nav>

  <div class="container">
    <div class="row g-4">
      <!-- CATEGORY -->
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Kategori</h5>

            <form id="categoryForm" class="d-flex gap-2 mb-3">
              <input type="text" id="categoryName" class="form-control form-control-sm" placeholder="Nama kategori" required />
              <button class="btn btn-sm btn-primary" type="submit">+</button>
            </form>

            <ul id="categoryList" class="list-group list-group-flush"></ul>
          </div>
        </div>
      </div>

      <!-- TODO -->
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Todo Saya</h5>

            <form id="todoForm" class="row g-2 mb-3">
              <div class="col-6">
                <input type="text" id="todoTitle" class="form-control form-control-sm" placeholder="Judul todo" required />
              </div>
              <div class="col-4">
                <select id="todoCategory" class="form-select form-select-sm">
                  <option value="">Tanpa kategori</option>
                </select>
              </div>
              <div class="col-2">
                <button class="btn btn-sm btn-primary w-100" type="submit">+</button>
              </div>
            </form>

            <ul id="todoList" class="list-group list-group-flush"></ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let categories = [];

    async function api(path, options = {}) {
      const res = await fetch("/api" + path, {
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        ...options,
      });
      const data = await res.json();
      if (res.status === 401) {
        window.location.href = "/";
        throw new Error("Unauthorized");
      }
      return data;
    }

    function categoryOptionsHtml(selectedId) {
      let html = '<option value="">Tanpa kategori</option>';
      categories.forEach((c) => {
        const selected = String(c.id) === String(selectedId) ? "selected" : "";
        html += `<option value="${c.id}" ${selected}>${c.name}</option>`;
      });
      return html;
    }

    async function loadCategories() {
      const res = await api("/categories");
      categories = res.data || [];

      const list = document.getElementById("categoryList");
      list.innerHTML = "";
      categories.forEach((c) => {
        const li = document.createElement("li");
        li.className = "list-group-item d-flex justify-content-between align-items-center";
        li.innerHTML = `
          <span>${c.name}</span>
          <button class="btn btn-sm btn-outline-danger" data-id="${c.id}">✕</button>
        `;
        li.querySelector("button").addEventListener("click", async () => {
          await api(`/categories/${c.id}`, { method: "DELETE" });
          await loadCategories();
          await loadTodos();
        });
        list.appendChild(li);
      });

      document.getElementById("todoCategory").innerHTML = categoryOptionsHtml();
    }

    async function loadTodos() {
      const res = await api("/todos");
      const todos = res.data || [];

      const list = document.getElementById("todoList");
      list.innerHTML = "";

      todos.forEach((t) => {
        const li = document.createElement("li");
        li.className = "list-group-item d-flex justify-content-between align-items-center gap-2";

        const catName = t.Category ? t.Category.name : "-";

        li.innerHTML = `
          <div class="form-check flex-grow-1">
            <input class="form-check-input done-checkbox" type="checkbox" ${t.is_done ? "checked" : ""} data-id="${t.id}" />
            <label class="form-check-label ${t.is_done ? "text-decoration-line-through text-muted" : ""}">
              ${t.title}
            </label>
            <div class="small text-muted">Kategori: ${catName}</div>
          </div>
          <select class="form-select form-select-sm cat-select" style="width: 140px;" data-id="${t.id}">
            ${categoryOptionsHtml(t.category_id)}
          </select>
          <button class="btn btn-sm btn-outline-danger del-btn" data-id="${t.id}">✕</button>
        `;

        li.querySelector(".done-checkbox").addEventListener("change", async (e) => {
          await api(`/todos/${t.id}`, {
            method: "PUT",
            body: JSON.stringify({ is_done: e.target.checked }),
          });
          await loadTodos();
        });

        li.querySelector(".cat-select").addEventListener("change", async (e) => {
          await api(`/todos/${t.id}`, {
            method: "PUT",
            body: JSON.stringify({ category_id: e.target.value || null }),
          });
          await loadTodos();
        });

        li.querySelector(".del-btn").addEventListener("click", async () => {
          await api(`/todos/${t.id}`, { method: "DELETE" });
          await loadTodos();
        });

        list.appendChild(li);
      });
    }

    document.getElementById("categoryForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = document.getElementById("categoryName").value;
      await api("/categories", { method: "POST", body: JSON.stringify({ name }) });
      document.getElementById("categoryName").value = "";
      await loadCategories();
    });

    document.getElementById("todoForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const title = document.getElementById("todoTitle").value;
      const category_id = document.getElementById("todoCategory").value || null;
      await api("/todos", { method: "POST", body: JSON.stringify({ title, category_id }) });
      document.getElementById("todoTitle").value = "";
      await loadTodos();
    });

    document.getElementById("logoutBtn").addEventListener("click", async () => {
      await api("/auth/logout", { method: "POST" });
      window.location.href = "/";
    });

    (async function init() {
      await loadCategories();
      await loadTodos();
    })();
  </script>
</body>
</html>
